---
import { auth } from "../auth";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (session) {
  return Astro.redirect("/");
}
---

<!doctype html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Connexion | Client Dashboard</title>

  <style>
    :root {
      --background: #f5f7fb;
      --card: #ffffff;
      --text: #172033;
      --muted: #718096;
      --border: #e7ebf2;
      --primary: #4f46e5;
      --shadow: 0 8px 30px rgba(15, 23, 42, 0.07);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      display: grid;
      place-items: center;

      background: var(--background);
      color: var(--text);

      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    .login-card {
      width: min(420px, calc(100% - 32px));

      background: var(--card);

      border: 1px solid var(--border);
      border-radius: var(--radius);

      padding: 32px;

      box-shadow: var(--shadow);

      text-align: center;
    }

    .icon {
      width: 58px;
      height: 58px;

      margin: 0 auto 18px;

      display: grid;
      place-items: center;

      border-radius: 16px;

      background: var(--primary);
      color: white;

      font-size: 26px;
    }

    h1 {
      margin: 0;

      font-size: 26px;
    }

    p {
      margin: 10px 0 26px;

      color: var(--muted);

      font-size: 14px;
      line-height: 1.5;
    }

    .google-button {
      width: 100%;

      padding: 13px 18px;

      border: 1px solid var(--border);
      border-radius: 10px;

      background: white;
      color: var(--text);

      cursor: pointer;

      font-size: 14px;
      font-weight: 600;

      transition: 0.2s;
    }

    .google-button:hover {
      background: #f8fafc;
    }
  </style>
</head>

<body>

  <section class="login-card">

    <div class="icon">
      📍
    </div>

    <h1>
      Client Dashboard
    </h1>

    <p>
      Connectez-vous avec votre compte Google pour accéder au tableau de bord des clients.
    </p>

    <button
      id="google-login"
      class="google-button"
      type="button"
    >
      Se connecter avec Google
    </button>

  </section>

<script>
  import { authClient } from "../lib/auth-client";

  const button = document.getElementById("google-login");

  button?.addEventListener("click", async () => {
    await authClient.signIn.social({
      provider: "google",
      callbackURL: "/",
    });
  });
</script>

</body>

</html>